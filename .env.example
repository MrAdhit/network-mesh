# Copy to .env.secrets and fill in. Used by bootstrap.sh and cgnat-test.sh.
#
# Cloudflare API token scoped to Account > Zero Trust > Edit, plus the account id.
# The control plane uses it to provision the Zero Trust org and mint a service token;
# nodes never see it.
CF_API_TOKEN=
CF_ACCOUNT_ID=

# Tailscale API access token. The control plane mints per-node auth keys from it.
TS_API_TOKEN=
