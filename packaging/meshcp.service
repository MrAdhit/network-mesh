[Unit]
Description=mesh control plane
Documentation=https://github.com/MrAdhit/network-mesh
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/meshcp
# MESH_CP_SECRET lives here, and the postinstall generates one if the file has none. Without it
# the stored Cloudflare and Tailscale tokens are sealed under a key that dies with the process.
EnvironmentFile=/etc/meshcp/meshcp.env
StateDirectory=meshcp
Restart=always
RestartSec=5

# A server that only needs its database and a listening socket.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Binding 3478 and 3479 for the STUN responders needs no privilege, but 80 or 443 would if
# someone points MESH_CP_BIND at one.
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
