# Environment for meshd. Everything here is optional: a packaged binary already knows which
# control plane it was built for, and everything else it needs comes from there.
#
# Joining a network is `meshctl join <enrollment-key>`, not a variable.

# Which control plane to enrol with. Overrides the one compiled in. A node that has already
# enrolled keeps talking to whatever it enrolled against regardless.
#MESH_CP_URL=

# Defaults to the hostname. Names are not unique; the mesh address always is.
#MESH_NODE_NAME=

# Where the node's keys and registration live.
#MESH_STATE_DIR=/var/lib/mesh

# The kernel interface. On macOS only a utunN form asks for a specific unit.
#MESH_TUN_NAME=mesh0

# Set to 0 to stop this node replacing its own binaries from the control plane.
#MESH_AUTOUPDATE=1

#MESH_LOG=info,mesh_core=debug
