# Environment for meshcp.
#
# MESH_CP_SECRET is the one that matters. It encrypts the users' Cloudflare and Tailscale
# tokens before they touch the database, so losing it makes every stored credential unreadable
# and every account has to paste theirs again. The postinstall generates one here if this file
# has none; back it up with the database, not separately from it.
MESH_CP_SECRET=

MESH_CP_BIND=0.0.0.0:8080
MESH_CP_DB=/var/lib/meshcp/meshcp.db

# Two STUN responders on different ports, which is what lets a node tell a NAT that assigns a
# mapping per destination from one that does not. One responder cannot answer that question.
MESH_CP_STUN_BIND=0.0.0.0:3478
MESH_CP_STUN_BIND2=0.0.0.0:3479
# What nodes are told to send binding requests to. Must be reachable from where they are, so it
# is a public address rather than the bind address.
#MESH_CP_STUN_ADVERTISE=cp.example.net:3478,cp.example.net:3479

# The URL this control plane is reached on, baked into the install script it serves. Only needed
# when something in front rewrites the Host header.
#MESH_CP_PUBLIC_URL=https://cp.example.net

#MESH_LOG=info,meshcp=debug
