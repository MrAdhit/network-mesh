[Unit]
Description=mesh node daemon
Documentation=https://github.com/MrAdhit/network-mesh
# The backhauls need routable addresses, and starting before there are any just means the first
# minute is spent retrying.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# /usr/bin because this copy ships inside a package. install.sh writes its own unit pointing at
# whatever --prefix it was given; the two are a pair and any change here belongs there too.
ExecStart=/usr/bin/meshd
EnvironmentFile=-/etc/mesh/meshd.env
# Creates and owns /var/lib/mesh, which holds the node's keys and its registration.
StateDirectory=mesh
# The kernel interface is the only thing in the daemon that needs privilege.
AmbientCapabilities=CAP_NET_ADMIN
DeviceAllow=/dev/net/tun rw
# An unattended machine has nobody to restart it, and a member that stays down is the failure
# this whole project exists to avoid.
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
